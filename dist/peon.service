[Unit]
Description=peon - run human-approved commands from Forgejo issues
Documentation=https://github.com/TomasTomecek/peon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/peon --config /etc/peon/config.yaml check-config
ExecStart=/usr/bin/peon --config /etc/peon/config.yaml run
Restart=on-failure
RestartSec=30s
StateDirectory=peon
StateDirectoryMode=0700
UMask=0077

# peon runs as root so it can ask systemd to start job units, but with no
# capabilities and a tight sandbox: the process that parses Forgejo input
# cannot touch the system itself. Jobs run in separate transient units
# (peon-job-<id>.service), which this hardening does not apply to.
# (SPEC.md §7.1)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
